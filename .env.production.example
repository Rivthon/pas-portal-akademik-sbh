APP_NAME="Portal Akademik"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://portal.example.ac.id

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Required only when running CreateAdminUserSeeder.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
